# Copy this file to .env and fill in real values. Never commit .env.

# Postgres password for the db container (pick a long random string)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Used to encrypt tenant secrets (OpenAI keys, SMTP passwords) at rest.
# Must be at least 32 random characters. Generate with: openssl rand -hex 32
APP_SECRET=change-me-to-32+-random-characters

# Used to sign login sessions and private preview links.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-32+-random-characters

# The public URL this app will be reachable at once your reverse proxy is wired
# up, e.g. https://sync.yourdomain.com - used only to build private listening
# links inserted into outreach emails.
PUBLIC_URL=https://sync.yourdomain.com

# Local port (bound to 127.0.0.1 only) that your existing reverse proxy should
# forward the chosen subdomain to. Change this if 8090 is already taken by
# another app on this server.
APP_PORT=8090
